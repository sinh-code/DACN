<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="70dp">

        <!-- ⭐ HERO SECTION -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/hero_gradient"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">   <!-- ⭐ Đưa gần lề trên -->

            <!-- ⭐ Title -->
            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="House Coffee"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <!-- ⭐ Subtitle (Hiện lại – không bị che) -->
            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/heroTitle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="6dp"
                android:text="Thưởng thức hương vị cà phê tuyệt vời"
                android:textSize="16sp"
                android:alpha="0.95"
                android:textColor="@color/white" />

            <!-- ⭐ Search Bar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:alpha="0.6"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/searchEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Tìm kiếm cà phê..."
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/black"
                        android:textSize="14sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </RelativeLayout>


        <!-- ✅ Tiêu đề danh sách -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu Cà Phê"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_margin="16dp"/>

        <!-- ✅ RecyclerView tự cuộn -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCoffee"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"/>
    </LinearLayout>

    <!-- ✅ Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        android:background="@android:color/white"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
